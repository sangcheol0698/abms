# 데이터베이스
DB_URL=jdbc:mysql://localhost:3308/abms
DB_USERNAME=abms
DB_PASSWORD=abms

# AI 어시스턴트 / AI 주간 보고서 (미설정 시 어시스턴트 비활성, 보고서는 템플릿으로 생성)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# 카카오맵 JavaScript 키 (카카오 개발자 콘솔에서 사이트 도메인 등록 후 발급, 미설정 시 지도 대신 주소·바로가기 링크만 표시)
KAKAO_JS_KEY=
# 카카오 REST API 키 (서버에서 주소 → 좌표 변환, 미설정 시 브라우저에서 찾은 좌표만 저장)
KAKAO_REST_KEY=

# 첨부 파일 저장 위치 (기본 ./data/attachments)
ABMS_STORAGE_PATH=

# 운영 환경 최초 기동 시 관리자 계정 생성 (계정이 하나도 없을 때만 동작)
ABMS_ADMIN_EMAIL=
ABMS_ADMIN_PASSWORD=
